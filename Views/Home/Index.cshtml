<div id="seleccion-tipo-timer" class="tipo-timer-container">
	<div class="consulta-tipo-timer">
		<span>¿Qué vas a hacer?</span>		
	</div>
	<div class="select-container">
		<select name="tipo-timer" id="tipo-timer">
			
		</select>
		<form id="form-tipo-personalizado" class="form-tipo-timer-nuevo">
			<div class="input-tipo-container">
				<input class="text-input" type="text" name="tipo-personalizado" id="tipo-personalizado" placeholder="Escribe un motivo" maxlength="20" required />
				<span id="error-tipo-personalizado" class="error-span no-mostrar"><i class="bi bi-exclamation-circle icon-error"></i>Error</span>
			</div>			
			<button class="submit-button" type="submit"><i class="bi bi-plus icono-pequeno"></i></button>
		</form>
	</div>
</div>
<div class="timer-container">
	<a href="#modal" class="open-modal" id="open-modal">
		<div class="circulo-exterior">
			<div class="circulo-medio" id="circulo-medio">
				<div class="circulo-interior" id="circulo-interior">
				</div>
			</div>
			<div class="timer">
				<span id="horas" class="tiempo">00</span>
				<span id="separador-hm" class="tiempo">:</span>
				<span id="minutos" class="tiempo">00</span>
				<span id="separador-ms" class="tiempo">:</span>
				<span id="segundos" class="tiempo">00</span>
			</div>
		</div>
	</a>
	
</div>
<div class="botones-container">
	<button id="menos5-boton" class="control-tiempo-button">
		- 5 min
	</button>
	<button id="iniciar-boton" class="accion-button">
		<i class="bi bi-play-fill icon-boton-accion"></i>
	</button>
	<button id="pausar-boton" class="accion-button no-mostrar">
		<i class="bi bi-pause icon-boton-accion"></i>
	</button>
	<button id="reiniciar-boton" class="accion-button no-mostrar">
		<i class="bi bi-arrow-counterclockwise icon-boton-accion"></i>
	</button>
	<button id="mas5-boton" class="control-tiempo-button">
		+ 5 min
	</button>
</div>
<div class="linea-separadora-horizontal"></div>
<div class="historial-container">
	<div class="encabezado-historial">
		<i class="bi bi-bar-chart-fill icon-header-sesion-card"></i>
		<h1 class="encabezado-historial-h1">Historial de sesiones</h1>
	</div>
	<div class="sesiones-container" id="sesiones-container">

	</div>
	
</div>

